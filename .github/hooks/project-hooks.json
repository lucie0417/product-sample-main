{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": ".github/hooks/scripts/session-init.sh",
        "powershell": ".github/hooks/scripts/session-init.ps1",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": ".github/hooks/scripts/session-end.sh",
        "powershell": ".github/hooks/scripts/session-end.ps1",
        "cwd": ".",
        "timeoutSec": 15
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": ".github/hooks/scripts/log-prompt.sh",
        "powershell": ".github/hooks/scripts/log-prompt.ps1",
        "cwd": ".",
        "env": {
          "LOG_LEVEL": "INFO"
        },
        "timeoutSec": 5
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": ".github/hooks/scripts/security-check.sh",
        "powershell": ".github/hooks/scripts/security-check.ps1",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}
